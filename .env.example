# ==========================================================
# Пример переменных окружения. Скопируй в .env и заполни.
#    cp .env.example .env
# ==========================================================

# --- Генерация синтетического датасета и LLM-as-a-Judge ---
# Токен доступа к Chutes (https://chutes.ai) для DeepSeek-V3
CHUTES_API_TOKEN=your_chutes_api_token_here

# --- Локальный инференс (Ollama) ---
# Меняй, если Ollama крутится не локально (например, в docker-compose: http://ollama:11434/api/chat)
OLLAMA_URL=http://localhost:11434/api/chat
MODEL_NAME=qwen-reviewer:latest
